# Rendered by `covey sync` -- do not edit directly.
# Source: share/caddy/Caddyfile.in
{
	admin localhost:2019
	# Every listener is loopback-only. Without this Caddy binds :443 on all
	# interfaces, and anything on the LAN that sends a site's name as SNI/Host
	# reaches it - including Mailpit's inbox, which Docker deliberately binds
	# to 127.0.0.1. Other machines cannot resolve *.localhost anyway, so this
	# loses nothing.
	default_bind 127.0.0.1 [::1]
}

# The app itself: root, PHP and static files.
#   args[0] = site directory
#   args[1] = php-fpm socket
# HTTPS=on is passed to PHP explicitly because a shared site (below) arrives as
# plain HTTP from the tunnel; the visitor's connection is HTTPS, and without
# this the app would generate http:// links. For a .localhost site it is
# already on, so setting it is a no-op there.
(covey_app) {
	root * {args[0]}

	# Framework layout (public/index.php) wins; otherwise serve the dir itself.
	@public file public/index.php
	handle @public {
		root * {args[0]}/public
		php_fastcgi unix/{args[1]} {
			env HTTPS on
		}
		file_server
	}

	handle {
		php_fastcgi unix/{args[1]} {
			env HTTPS on
		}
		file_server
	}
}

# A site at https://<name>.localhost.
# A wildcard cert (*.localhost) can't be used: TLS clients reject a wildcard
# with only one label after it, so each site gets its own named block + cert.
(covey_site) {
	tls internal
	import covey_app {args[0]} {args[1]}
}

# A site being shared with `covey share`: a loopback-only plain-HTTP listener
# that serves the site whatever Host header arrives, which is what a tunnel
# sends (xyz.trycloudflare.com). The tunnel terminates TLS.
#
# Stricter than the local listener, because this one is public:
#  - dotfiles (.env, .git/) are refused outright, whatever the docroot;
#  - a framework app (kind "app") is pinned to public/ with no fallback to the
#    project root, so if public/index.php vanishes mid-checkout the share fails
#    closed instead of publishing vendor/, storage/ and the repository.
# A handle, not a bare respond: Caddy runs handle blocks before respond, so a
# bare respond lost to covey_app's catch-all handle and .env was served. Handle
# blocks with named matchers keep their order, and this one is imported first.
(covey_private) {
	@private {
		path /.* */.*
		not path /.well-known/*
	}
	handle @private {
		respond 404
	}
}
(covey_shared_app) {
	bind 127.0.0.1
	import covey_private
	root * {args[0]}/public
	php_fastcgi unix/{args[1]} {
		env HTTPS on
	}
	file_server
}
(covey_shared_static) {
	bind 127.0.0.1
	import covey_private
	import covey_app {args[0]} {args[1]}
}

# A site taken down with `covey site down`. It keeps a block (and therefore a
# working certificate) so the reason is legible: dropping the block instead
# would give a bare TLS/connection error with no hint that this was deliberate.
#   args[0] = site name
(covey_disabled) {
	tls internal

	respond `covey: {args[0]} is disabled
  bring it back: covey site up {args[0]}
` 503
}

# Mailpit's web UI. A covey-owned name, so ~/Covey/mail is not served (doctor
# reports it as reserved_name). Plain-HTTP 127.0.0.1:8025 still works too.
mail.localhost {
	tls internal
	reverse_proxy 127.0.0.1:8025
}
