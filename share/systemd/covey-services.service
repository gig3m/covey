[Unit]
Description=Covey services (MySQL, PostgreSQL, Redis, Mailpit, optional extras)
PartOf=covey.target
After=network.target
# A pull needs DNS, which may not be up yet when this starts at login.
# Retry rather than ordering on network-online.target: that target is inert
# in the user manager (see docs/HACKING.md).
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
# Through covey, which reads the optional services in the stack
# (~/.config/covey/services.env) under the lock `covey services enable` takes.
ExecStart=%h/.local/share/covey/bin/covey services-unit start
ExecStop=%h/.local/share/covey/bin/covey services-unit stop
TimeoutStartSec=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=covey.target
