pkgbase = covey
	pkgdesc = Local PHP development environment where a directory is an HTTPS site
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/gig3m/covey
	install = covey.install
	arch = any
	license = MIT
	depends = caddy
	depends = nss
	depends = php
	depends = php-fpm
	optdepends = docker: MySQL, PostgreSQL, Redis, and Mailpit
	optdepends = docker-compose: Compose plugin (covey runs docker compose)
	optdepends = sudo: installing PHP packages and trusting the local CA
	optdepends = composer: per-site platform requirement checks
	optdepends = curl: waiting for a shared hostname to appear in public DNS
	optdepends = cloudflared: public URLs with covey share
	optdepends = php-gd: gd (covey php configure 85)
	optdepends = php-sqlite: sqlite3 and pdo_sqlite (covey php configure 85)
	optdepends = php-pgsql: pgsql and pdo_pgsql (covey php configure 85)
	optdepends = php-sodium: sodium (covey php configure 85)
	optdepends = php-igbinary: igbinary, loaded before redis (covey php configure 85)
	optdepends = php-redis: redis (covey php configure 85)
	optdepends = php-legacy: PHP 8.3 CLI
	optdepends = php-legacy-fpm: PHP 8.3 FPM
	optdepends = php-legacy-gd: gd for PHP 8.3
	optdepends = php-legacy-sqlite: sqlite for PHP 8.3
	optdepends = php-legacy-pgsql: PostgreSQL for PHP 8.3
	optdepends = php-legacy-sodium: sodium for PHP 8.3
	optdepends = php-legacy-igbinary: igbinary for PHP 8.3
	optdepends = php-legacy-redis: redis for PHP 8.3
	options = !debug
	options = !strip
	source = covey-0.2.0.tar.gz::https://github.com/gig3m/covey/archive/refs/tags/v0.2.0.tar.gz
	sha256sums = SKIP

pkgname = covey
