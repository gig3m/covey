#!/usr/bin/env bash
# covey - a local PHP development environment for Linux.
# Manages the platform (web server, PHP, services); never touches your project files.
set -euo pipefail

COVEY_SRC="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
COVEY_HOME="${COVEY_HOME:-$HOME/.local/share/covey}"
COVEY_CONFIG="${COVEY_CONFIG:-$HOME/.config/covey}"
COVEY_SITES="${COVEY_SITES:-$HOME/Covey}"
COVEY_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
COVEY_DEFAULT_PHP="${COVEY_DEFAULT_PHP:-85}"
UNIT_DIR="$HOME/.config/systemd/user"
COVEY_COMPOSE="$COVEY_HOME/share/compose/covey.yaml"

PROVIDERS_TSV="$COVEY_SRC/share/providers.tsv"
EXTENSIONS_TXT="$COVEY_SRC/share/extensions.txt"
COVEY_EXT_PKGS="gd sodium igbinary redis sqlite pgsql"

die()  { echo "covey: $*" >&2; exit 1; }
warn() { echo "covey: $*" >&2; }

pfield()   { awk -F'\t' -v v="$1" '!/^#/ && $1==v {print $'"$2"'; exit}' "$PROVIDERS_TSV"; }
series()   { pfield "$1" 2; }
php_bin()  { pfield "$1" 3; }
fpm_bin()  { pfield "$1" 4; }
php_pkgs() { pfield "$1" 5; }
conf_dir()  { pfield "$1" 6; }
pkg_prefix(){ pfield "$1" 7; }
all_tags() { awk -F'\t' '!/^#/ && NF>1 {print $1}' "$PROVIDERS_TSV"; }
tag_installed() { [[ -x "$(php_bin "$1")" && -x "$(fpm_bin "$1")" ]]; }

# Full version of an installed provider (e.g. 8.3.33); falls back to its series.
tag_version() {
  local b; b="$(php_bin "$1")"
  if [[ -x "$b" ]]; then "$b" -r 'echo PHP_VERSION;' 2>/dev/null || series "$1"
  else series "$1"; fi
}

tag_for_series() {
  local want="$1" t
  for t in $(all_tags); do [[ "$(series "$t")" == "$want" ]] && { echo "$t"; return 0; }; done
  return 1
}
tag_for_version() {  # 8.3.33 -> 83
  local v="$1" t
  for t in $(all_tags); do [[ "$(tag_version "$t")" == "$v" ]] && { echo "$t"; return 0; }; done
  return 1
}

# --- version resolution -----------------------------------------------------
# Delegated to core.php so `sync` and `doctor` always agree.
core() { COVEY_HOME="$COVEY_SRC" COVEY_SITES="$COVEY_SITES" COVEY_DEFAULT_PHP="$COVEY_DEFAULT_PHP" \
         "$(php_bin "$COVEY_DEFAULT_PHP")" "$COVEY_SRC/share/php/core.php" "$@"; }
site_php_tag() { core resolve "$1" 2>/dev/null || echo "$COVEY_DEFAULT_PHP"; }
# name \t dir \t tag \t enabled(1|0) \t kind. One enumeration for every caller.
core_sites()   { core sites 2>/dev/null; }

# --- per-site enablement ----------------------------------------------------
# Declared intent, so it has to be stored; see the note in share/php/core.php.
# Never written inside the project - covey does not touch project files.
DISABLED_FILE="$COVEY_CONFIG/disabled"
# A site is whatever core.php enumerates - not merely a directory - so a
# reserved name such as ~/Covey/mail is not one.
site_exists()   { core_sites | cut -f1 | grep -qxF -- "$1"; }
site_disabled() { [[ -f "$DISABLED_FILE" ]] && grep -qxF "$1" "$DISABLED_FILE"; }

# --- pools ------------------------------------------------------------------
# A reload (USR2) returns as soon as the signal is sent, before php-fpm has
# re-read its config. Wait (briefly) until the socket accepts a connection, so
# a command that changes a pool hands back a pool that works.
wait_for_pool() {
  "$(php_bin "$COVEY_DEFAULT_PHP")" -r '
    for ($i = 0; $i < 50; $i++) {
      $s = @stream_socket_client("unix://" . $argv[1], $e, $es, 0.1);
      if ($s) { fclose($s); exit(0); }
      usleep(100000);
    }
    exit(1);' -- "$COVEY_RUNTIME/covey/php$1.sock" \
    || warn "PHP $(series "$1") pool did not come back within 5s (covey logs php)"
}

ensure_php_pool() {
  local ver="$1"
  tag_installed "$ver" || { warn "PHP $(series "$ver") not installed (try: covey php install $ver)"; return 1; }
  mkdir -p "$COVEY_CONFIG/php"
  local conf="$COVEY_CONFIG/php/$ver.conf" tmp k v
  tmp="$(mktemp)"
  sed -e "s|@RUNTIME@|$COVEY_RUNTIME|g" -e "s|@VER@|$ver|g" \
      "$COVEY_SRC/share/php/pool.conf.in" > "$tmp"
  # php_value, not php_admin_value: an app can still ini_set() over these,
  # as it could over a real php.ini.
  while IFS=$'\t' read -r k v; do
    [[ -n "$k" ]] && printf 'php_value[%s] = %s\n' "$k" "$v" >> "$tmp"
  done < <(core ini)
  # Never install a config php-fpm rejects: a reload would take the pool down.
  if ! "$(fpm_bin "$ver")" -t --fpm-config "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    warn "PHP $(series "$ver"): generated pool config failed php-fpm -t; kept the previous one"
    return 1
  fi
  # A running pool only reads its config at start or reload, so a changed
  # config means a reload - otherwise `covey php set` would appear to do nothing.
  local changed=1
  cmp -s "$tmp" "$conf" && changed=0
  mv "$tmp" "$conf"
  chmod 644 "$conf"
  echo "COVEY_FPM_BIN=$(fpm_bin "$ver")" > "$COVEY_CONFIG/php/$ver.env"
  systemctl --user add-wants covey.target "covey-fpm@$ver.service" >/dev/null 2>&1 || true
  if systemctl --user is-active --quiet "covey-fpm@$ver.service"; then
    if [[ $changed -eq 1 ]]; then
      systemctl --user reload "covey-fpm@$ver.service" 2>/dev/null || true
      wait_for_pool "$ver"
    fi
  else
    systemctl --user start "covey-fpm@$ver.service" 2>/dev/null || true
  fi
}

render() {
  sed -e "s|@RUNTIME@|$COVEY_RUNTIME|g" -e "s|@SITES@|$COVEY_SITES|g" \
      -e "s|@VER@|$COVEY_DEFAULT_PHP|g" -e "s|@HOME@|$HOME|g" "$1" > "$2"
}

# --- services ---------------------------------------------------------------
dc() { docker compose -f "$COVEY_COMPOSE" "$@"; }
docker_ok() { docker info >/dev/null 2>&1; }

cmd_services() {
  case "${1:-status}" in
    up|start)
      docker_ok || die "docker is not available (is docker.service running?)"
      systemctl --user start covey-services.service ;;
    down|stop) systemctl --user stop covey-services.service ;;
    status)
      docker_ok || { echo "docker unavailable"; return 1; }
      printf '%-10s %-12s %s\n' SERVICE STATE PORTS
      dc ps --format '{{.Service}}\t{{.State}}\t{{.Ports}}' 2>/dev/null \
        | awk -F'\t' '{printf "%-10s %-12s %s\n", $1, $2, $3}' \
        || echo "(not started)" ;;
    logs) shift; dc logs --tail "${1:-50}" ;;
    *) die "usage: covey services [up|down|status|logs]" ;;
  esac
}

mysql_q() { dc exec -T mysql mariadb -uroot --skip-column-names -B -e "$1" 2>/dev/null; }

cmd_db() {
  docker_ok || die "docker is not available"
  case "${1:-list}" in
    list)
      mysql_q "SHOW DATABASES;" | grep -vE '^(information_schema|performance_schema|mysql|sys)$' \
        || die "could not reach mysql (try: covey services up)" ;;
    create)
      local n="${2:?usage: covey db create <name>}"
      [[ "$n" =~ ^[A-Za-z0-9_]+$ ]] || die "invalid database name: $n"
      mysql_q "CREATE DATABASE IF NOT EXISTS \`$n\`;" && echo "database '$n' ready" ;;
    drop)
      local n="${2:?usage: covey db drop <name>}"
      [[ "$n" =~ ^[A-Za-z0-9_]+$ ]] || die "invalid database name: $n"
      mysql_q "DROP DATABASE IF EXISTS \`$n\`;" && echo "database '$n' dropped" ;;
    shell) shift; dc exec mysql mariadb -uroot "$@" ;;
    *) die "usage: covey db [list|create <name>|drop <name>|shell]" ;;
  esac
}

# --- commands ---------------------------------------------------------------
cmd_install() {
  local src="$COVEY_SRC"
  mkdir -p "$COVEY_CONFIG/php" "$COVEY_SITES" "$UNIT_DIR" "$HOME/.claude/skills"
  [[ -e "$COVEY_HOME" && ! -L "$COVEY_HOME" ]] && die "$COVEY_HOME exists and is not a symlink"
  ln -sfn "$src" "$COVEY_HOME"
  for u in covey.target covey-caddy.service 'covey-fpm@.service' 'covey-share@.service' covey-sync.service covey-sync.path covey-services.service; do
    ln -sfn "$COVEY_HOME/share/systemd/$u" "$UNIT_DIR/$u"
  done
  ln -sfn "$COVEY_HOME/agents/skills/covey" "$HOME/.claude/skills/covey"
  # omarchy-shell bar plugin (hot-reloads on save)
  if [[ -d "$HOME/.config/omarchy/plugins" ]]; then
    ln -sfn "$COVEY_HOME/share/omarchy/covey" "$HOME/.config/omarchy/plugins/covey"
  fi
  systemctl --user daemon-reload
  systemctl --user add-wants covey.target covey-caddy.service >/dev/null 2>&1 || true
  systemctl --user add-wants covey.target covey-sync.path >/dev/null 2>&1 || true
  systemctl --user add-wants covey.target covey-services.service >/dev/null 2>&1 || true
  ensure_php_pool "$COVEY_DEFAULT_PHP" || true
  # User services cannot bind :80/:443 unless the unprivileged port floor is
  # lowered. Say so explicitly rather than let caddy fail to start.
  local floor; floor="$(sysctl -n net.ipv4.ip_unprivileged_port_start 2>/dev/null || echo 1024)"
  if [[ "$floor" -gt 80 ]]; then
    warn "user services cannot bind port 80 yet. Run:"
    warn "  echo 'net.ipv4.ip_unprivileged_port_start=80' | sudo tee /etc/sysctl.d/99-covey.conf"
    warn "  sudo sysctl --system"
  fi
  cmd_sync
  echo "covey installed. sites root: $COVEY_SITES"
}

cmd_sync() {
  site_lock
  local out="$COVEY_CONFIG/Caddyfile" tmp; tmp="$(mktemp)"
  render "$COVEY_SRC/share/caddy/Caddyfile.in" "$tmp"
  # Enumeration, name validation and version resolution all come from core.php,
  # so sync cannot disagree with doctor about which sites exist or what they run.
  local n=0 off=0 used=() name d ver enabled kind
  while IFS=$'\t' read -r name d ver enabled kind; do
    [[ -n "$name" ]] || continue
    if [[ "$enabled" == "1" ]]; then
      used+=("$ver")
      printf '\n%s.localhost {\n\timport covey_site %s %s/covey/php%s.sock\n}\n' \
        "$name" "$d" "$COVEY_RUNTIME" "$ver" >> "$tmp"
      n=$((n+1))
    else
      # Still served, but only to say why - see (covey_disabled).
      printf '\n%s.localhost {\n\timport covey_disabled %s\n}\n' "$name" "$name" >> "$tmp"
      off=$((off+1))
    fi
  done < <(core_sites)
  [[ $((n + off)) -eq 0 ]] && printf '\nlocalhost {\n\trespond "covey: no sites in %s"\n}\n' "$COVEY_SITES" >> "$tmp"

  # Shared sites get a loopback listener for their tunnel. A share whose site
  # is no longer served (taken down, soloed away, deleted) is ended here, so
  # nothing is published that covey is not serving.
  local sname sport sstate sdir
  while IFS=$'\t' read -r sname sport sstate; do
    [[ -n "$sname" ]] || continue
    sdir="$(core_sites | awk -F'\t' -v n="$sname" '$1 == n && $4 == "1" {print $2"\t"$3"\t"$5}')"
    if [[ -z "$sdir" ]]; then
      systemctl --user stop "covey-share@$sname.service" 2>/dev/null || true
      systemctl --user reset-failed "covey-share@$sname.service" 2>/dev/null || true
      continue
    fi
    [[ "$sstate" == "failed" ]] && continue
    local sd stag skind
    IFS=$'\t' read -r sd stag skind <<< "$sdir"
    printf '\nhttp://:%s {\n\timport covey_shared_%s %s %s/covey/php%s.sock\n}\n' \
      "$sport" "$([[ "$skind" == "app" ]] && echo app || echo static)" "$sd" "$COVEY_RUNTIME" "$stag" >> "$tmp"
  done < <(core shares 2>/dev/null)

  if ! caddy validate --config "$tmp" --adapter caddyfile >/dev/null 2>&1; then
    caddy validate --config "$tmp" --adapter caddyfile 2>&1 | grep -iE 'error' | head -3 >&2
    rm -f "$tmp"; die "generated Caddyfile failed validation (kept existing config)"
  fi
  mv "$tmp" "$out"

  local seen=" " v
  for v in "${used[@]:-}"; do
    [[ -z "$v" || "$seen" == *" $v "* ]] && continue
    seen+="$v "; ensure_php_pool "$v" || true
  done
  # A pool no site asks for any more is just resident memory. Stopping it here
  # is what makes `covey site down` able to actually free something, rather
  # than only stop serving - pools are per PHP version, shared by every site on
  # it, so this only fires on the last site of a version.
  local t
  for t in $(all_tags); do
    [[ "$seen" == *" $t "* ]] && continue
    systemctl --user is-active --quiet "covey-fpm@$t.service" || continue
    systemctl --user stop "covey-fpm@$t.service" 2>/dev/null || true
    rm -f "$UNIT_DIR/covey.target.wants/covey-fpm@$t.service"
    systemctl --user daemon-reload 2>/dev/null || true
  done
  systemctl --user is-active --quiet covey-caddy.service && systemctl --user reload covey-caddy.service
  # Which sites are served just changed, so doctor's cached model is stale.
  drop_doctor_cache
  if [[ $off -gt 0 ]]; then echo "covey: synced $n site(s), $off disabled"
  else echo "covey: synced $n site(s)"; fi
}

cmd_php() {
  case "${1:-list}" in
    list)
      printf '%-6s %-8s %-10s %s\n' TAG SERIES STATE VERSION
      local t st
      for t in $(all_tags); do
        st="missing"; tag_installed "$t" && st="installed"
        [[ "$t" == "$COVEY_DEFAULT_PHP" ]] && st="$st*"
        printf '%-6s %-8s %-10s %s\n' "$t" "$(series "$t")" "$st" "$(tag_installed "$t" && tag_version "$t" || php_pkgs "$t")"
      done
      echo "(* = default)" ;;
    install)
      local t="${2:?usage: covey php install <tag>}"
      [[ -n "$(series "$t")" ]] || die "unknown PHP tag: $t"
      tag_installed "$t" && { echo "PHP $(series "$t") already installed"; return 0; }
      local -a pkgs
      read -ra pkgs <<< "$(php_pkgs "$t")"
      echo "installing: ${pkgs[*]}"
      sudo pacman -S --needed --noconfirm "${pkgs[@]}" || die "install failed"
      ensure_php_pool "$t" && echo "PHP $(series "$t") ready" ;;
    configure) shift; cmd_php_configure "$@" ;;
    settings|ini) cmd_php_settings ;;
    set)   shift; cmd_php_set "$@" ;;
    unset) shift; cmd_php_unset "$@" ;;
    *) die "usage: covey php [list|install <tag>|configure <tag>|settings|set <key> <value>|unset <key>]" ;;
  esac
}

# --- php.ini settings ----------------------------------------------------------
# covey's own file of `key = value` lines, applied to every FPM pool by sync.
# Defaults live in core.php (PHP_INI_DEFAULTS); this file holds only what the
# user changed. FPM only: the php CLI (artisan, composer) reads /etc as usual.
PHP_INI_FILE="$COVEY_CONFIG/php.ini"

cmd_php_settings() {
  core status --json --no-containers 2>/dev/null | "$(php_bin "$COVEY_DEFAULT_PHP")" -r '
    $d = json_decode(stream_get_contents(STDIN), true);
    foreach ($d["php_ini"] ?? [] as $i)
      printf("%-22s %-10s %s\n", $i["key"], $i["value"],
             $i["custom"] ? "(set; default " . ($i["default"] ?? "PHP") . ")" : "");'
  echo "(covey php set <key> <value> to change; applies to served sites, not the php CLI)"
}

# Re-render every pool a site is using; ensure_php_pool restarts the changed ones.
apply_php_ini() {
  local t
  for t in $(all_tags); do
    systemctl --user is-active --quiet "covey-fpm@$t.service" && ensure_php_pool "$t"
  done
  drop_doctor_cache
}

cmd_php_set() {
  local k="${1:-}" v="${2:-}"
  [[ -n "$k" && $# -eq 2 ]] || die "usage: covey php set <key> <value>   (quote a value with spaces)"
  # One validator, in core.php, also applied when the file is read back - so a
  # hand edit cannot get past it either.
  core ini-check "$k" "$v" || die "invalid setting: $k = $v (letters, digits, spaces and . / : _ - + ~ & | ^ ! only)"
  # Only keys PHP itself knows: a typo would otherwise be written, rendered,
  # and silently ignored by FPM.
  "$(php_bin "$COVEY_DEFAULT_PHP")" -r 'exit(ini_get($argv[1]) === false ? 1 : 0);' -- "$k" \
    || die "PHP has no setting called $k"
  site_lock
  local tmp; tmp="$(mktemp "$COVEY_CONFIG/.php.ini.XXXXXX")"
  { [[ -f "$PHP_INI_FILE" ]] && grep -vE "^[[:space:]]*${k//./\\.}[[:space:]]*=" "$PHP_INI_FILE" || true
    printf '%s = %s\n' "$k" "$v"; } > "$tmp"
  mv "$tmp" "$PHP_INI_FILE"
  apply_php_ini
  echo "covey: $k = $v (served sites; pools reloaded)"
}

cmd_php_unset() {
  local k="${1:-}"
  [[ -n "$k" ]] || die "usage: covey php unset <key>"
  [[ "$k" =~ ^[a-z][a-z0-9_.]*$ ]] || die "invalid setting name: $k"
  site_lock
  if [[ ! -f "$PHP_INI_FILE" ]] || ! grep -qE "^[[:space:]]*${k//./\\.}[[:space:]]*=" "$PHP_INI_FILE"; then
    echo "covey: $k is not set"; return 0
  fi
  local tmp; tmp="$(mktemp "$COVEY_CONFIG/.php.ini.XXXXXX")"
  grep -vE "^[[:space:]]*${k//./\\.}[[:space:]]*=" "$PHP_INI_FILE" > "$tmp" || true
  mv "$tmp" "$PHP_INI_FILE"
  apply_php_ini
  echo "covey: $k back to its default"
}

# Enable the extension set for a provider. Needs root (writes /etc/php*/conf.d).
cmd_php_configure() {
  local t="${1:-$COVEY_DEFAULT_PHP}"
  [[ -n "$(series "$t")" ]] || die "unknown PHP tag: $t"
  tag_installed "$t" || die "PHP $(series "$t") is not installed (covey php install $t)"
  local cd_ pfx pkgs=() e
  cd_="$(conf_dir "$t")"; pfx="$(pkg_prefix "$t")"
  for e in $COVEY_EXT_PKGS; do pkgs+=("$pfx-$e"); done
  echo "installing extension packages: ${pkgs[*]}"
  sudo pacman -S --needed --noconfirm "${pkgs[@]}" || warn "some extension packages failed"
  local ini="$cd_/conf.d/covey.ini" tmp; tmp="$(mktemp)"
  {
    echo "; Managed by covey - enables the extension set a Laravel app expects."
    echo "; Arch ships these modules but leaves them off by default."
    while read -r e; do [[ -n "$e" ]] && echo "extension=$e"; done < "$EXTENSIONS_TXT"
  } > "$tmp"
  sudo install -Dm644 "$tmp" "$ini"; rm -f "$tmp"
  echo "wrote $ini"
  systemctl --user is-active --quiet "covey-fpm@$t.service" && \
    systemctl --user restart "covey-fpm@$t.service" || true
  local missing=() m
  for m in $(cat "$EXTENSIONS_TXT"); do
    "$(php_bin "$t")" -m 2>/dev/null | grep -qix "$m" || missing+=("$m")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    warn "PHP $(series "$t"): still not loaded: ${missing[*]}"
  else
    echo "PHP $(series "$t"): all covey extensions loaded"
  fi
}

# --- certificate trust -------------------------------------------------------
# Caddy's `trust` installs into the system store only, and short-circuits once
# it is there. Chrome and Firefox on Linux read their own NSS database, so
# without this the site is trusted by curl and rejected by every browser.
NSSDB="$HOME/.pki/nssdb"
CADDY_ROOT="$HOME/.local/share/caddy/pki/authorities/local/root.crt"
CA_NICK="Caddy Local Authority - 2026 ECC Root"

nss_has_ca() { certutil -d "sql:$NSSDB" -L 2>/dev/null | grep -q "Caddy Local Authority"; }

cmd_trust() {
  [[ -f "$CADDY_ROOT" ]] || die "no local CA yet at $CADDY_ROOT (start covey first)"
  sudo env XDG_DATA_HOME="$HOME/.local/share" HOME="$HOME" caddy trust >/dev/null 2>&1 \
    && echo "system store: ok" || warn "system store: caddy trust failed"
  if ! command -v certutil >/dev/null 2>&1; then
    warn "certutil not found (pacman -S nss) - browsers will not trust the CA"; return 1
  fi
  mkdir -p "$NSSDB"
  certutil -d "sql:$NSSDB" -L >/dev/null 2>&1 || certutil -d "sql:$NSSDB" -N --empty-password
  if nss_has_ca; then echo "browser (NSS) store: already trusted"
  else
    certutil -d "sql:$NSSDB" -A -t "C,," -n "$CA_NICK" -i "$CADDY_ROOT" \
      && echo "browser (NSS) store: added"
  fi
  echo "restart your browser for it to pick up the new certificate authority"
}

cmd_doctor() { core doctor "$@"; }

# --- up / down --------------------------------------------------------------
# The whole stack is ~440 MiB resident for a machine that is not doing PHP work
# today. `covey down` gives it back; `covey up` takes it again. Everything hangs
# off covey.target with PartOf=, so stopping the target stops caddy, every FPM
# pool, and the compose services in one step.
#
# Both invalidate doctor's cache so the bar widget does not show the old state
# for up to its refresh interval.
drop_doctor_cache() { rm -f "$COVEY_RUNTIME/covey/doctor.json"; }

cmd_up() {
  docker_ok || warn "docker is not available - services (mysql, redis, mailpit) will not start"
  # A deliberate start clears systemd's failure state and start-rate counters.
  # covey-services' StartLimitBurst exists to bound the at-login retry, but it
  # counts manual starts too: five `covey down`/`covey up` cycles in half an
  # hour (easy from the bar) left the services failed with start-limit-hit.
  systemctl --user reset-failed 'covey-*' 2>/dev/null || true
  systemctl --user start covey.target
  # Shares do not survive `covey down`, but their listeners are still in the
  # Caddyfile it was stopped with. Re-render so the config matches what runs.
  cmd_sync >/dev/null || true
  drop_doctor_cache
  cmd_status
}

cmd_down() {
  # Under the lock so a `covey share` in flight cannot start a tunnel after the
  # stack it belongs to has stopped.
  site_lock
  systemctl --user stop covey.target covey-caddy.service 'covey-fpm@*.service' \
    covey-services.service covey-sync.path 2>/dev/null || true
  drop_doctor_cache
  echo "covey is down"
}

cmd_restart() { cmd_down >/dev/null; cmd_up; }
cmd_reload()  { systemctl --user reload covey-caddy.service && echo "caddy reloaded"; }

cmd_status() { core status "$@"; }

# Whether the stack comes back at login. `covey down` is deliberately session
# only - it stops what is running now and leaves this setting alone.
cmd_autostart() {
  case "${1:-status}" in
    on)  systemctl --user enable covey.target >/dev/null 2>&1 && echo "covey will start at login" ;;
    off) systemctl --user disable covey.target >/dev/null 2>&1 && echo "covey will not start at login" ;;
    status)
      if systemctl --user is-enabled --quiet covey.target 2>/dev/null
      then echo "on  (covey starts at login)"
      else echo "off (covey does not start at login)"; fi ;;
    *) die "usage: covey autostart [on|off|status]" ;;
  esac
}

cmd_sites() {
  [[ -d "$COVEY_SITES" ]] || die "no sites root at $COVEY_SITES"
  local found=0 name d ver enabled kind
  while IFS=$'\t' read -r name d ver enabled kind; do
    [[ -n "$name" ]] || continue
    found=1
    if [[ "$enabled" == "1" ]]; then
      printf '%-20s %-7s php %-5s https://%s.localhost\n' "$name" "$kind" "$(series "$ver")" "$name"
    else
      printf '%-20s %-7s %-9s %s\n' "$name" "$kind" "disabled" "(covey site up $name)"
    fi
  done < <(core_sites)
  [[ $found -eq 0 ]] && echo "no sites yet - try: mkdir $COVEY_SITES/hello"
  return 0
}

# Per-site up/down. `covey down` stops the whole stack; this takes one site out
# of service without touching the rest - and without touching the project.
#
# Mutations hold a lock: the bar widget lets several switches be flipped in
# quick succession, and two of these racing would interleave rewrites of the
# disabled list and run sync twice over each other.
SOLO_FILE="$COVEY_CONFIG/solo"
#
# Re-entrant within one process (site commands call sync while holding it), and
# taken by cmd_sync itself: two bar instances sharing at once, or a share racing
# the covey-sync.path watcher, once ran two syncs over each other's pool config.
site_lock() {
  [[ -n "${COVEY_LOCK_HELD:-}" ]] && return 0
  mkdir -p "$COVEY_RUNTIME/covey" "$COVEY_CONFIG"
  exec 9>"$COVEY_RUNTIME/covey/site.lock"
  flock 9
  COVEY_LOCK_HELD=1
}
site_unlock() {
  [[ -n "${COVEY_LOCK_HELD:-}" ]] || return 0
  flock -u 9
  unset COVEY_LOCK_HELD
}
# Replace the disabled list with stdin, atomically.
write_disabled() {
  local tmp; tmp="$(mktemp "$COVEY_CONFIG/.disabled.XXXXXX")"
  cat > "$tmp"
  mv "$tmp" "$DISABLED_FILE"
}
saved_disabled() { tail -n +2 "$SOLO_FILE"; }

cmd_site() {
  local action="${1:-list}"
  case "$action" in
    list|"") cmd_sites ;;
    up|down)
      local name="${2:-}"
      [[ -n "$name" ]] || die "usage: covey site $action <name>"
      site_exists "$name" || die "no such site: $name (try: covey sites)"
      site_lock
      if [[ "$action" == "down" ]]; then
        site_disabled "$name" && { echo "covey: $name is already down"; return 0; }
        echo "$name" >> "$DISABLED_FILE"
        cmd_sync >/dev/null
        echo "covey: $name is down (covey site up $name to bring it back)"
      else
        site_disabled "$name" || { echo "covey: $name is already up"; return 0; }
        # Rewrite without the name; keep everything else byte for byte.
        { grep -vxF "$name" "$DISABLED_FILE" || true; } | write_disabled
        cmd_sync >/dev/null
        echo "covey: $name is up - https://$name.localhost"
      fi ;;
    solo)
      # Every other site off. The list that was off beforehand is kept so
      # `restore` puts back exactly that, not "everything on" - a half-finished
      # project that was down before solo stays down after it.
      local name="${2:-}"
      [[ -n "$name" ]] || die "usage: covey site solo <name>"
      site_exists "$name" || die "no such site: $name (try: covey sites)"
      site_lock
      local saved
      if [[ -f "$SOLO_FILE" ]]; then saved="$(saved_disabled)"   # re-solo: keep the original
      else saved="$( [[ -f "$DISABLED_FILE" ]] && cat "$DISABLED_FILE" || true)"; fi
      { echo "$name"; [[ -n "$saved" ]] && printf '%s\n' "$saved"; } > "$SOLO_FILE"
      core_sites | awk -F'\t' -v keep="$name" '$1 != "" && $1 != keep {print $1}' | write_disabled
      cmd_sync >/dev/null
      echo "covey: only $name is up - https://$name.localhost (covey site restore to end)"
      ;;
    restore)
      site_lock
      [[ -f "$SOLO_FILE" ]] || { echo "covey: not in solo mode"; return 0; }
      saved_disabled | write_disabled
      rm -f "$SOLO_FILE"
      cmd_sync >/dev/null
      echo "covey: solo ended, sites restored"
      ;;
    *) die "usage: covey site [list|up <name>|down <name>|solo <name>|restore]" ;;
  esac
}

# --- sharing -------------------------------------------------------------------
# `covey share <site>` publishes a site through the tunnel in share/tunnels.tsv
# (cloudflared by default). A share is a user unit, covey-share@<site>, under
# covey.target: its state is systemd's, and `covey down` ends it.
SHARE_WARNING="anyone with the URL can reach this site. With APP_DEBUG=true an
error page shows your .env - turn it off, or share for as long as you need."

share_url_wait() {
  local name="$1" i url
  for i in $(seq 1 60); do
    url="$(core share-url "$name")"
    [[ -n "$url" ]] && { echo "$url"; return 0; }
    systemctl --user is-failed --quiet "covey-share@$name.service" && return 1
    sleep 0.5
  done
  return 1
}

# A quick tunnel's hostname is created with the tunnel and takes a few seconds
# to appear in DNS. Resolvers cache the "not found" from a lookup made before
# then, so a URL opened the instant it is printed can fail for minutes. Hold
# it back until public DNS answers (bounded; best effort).
# Cloudflare's resolvers pick a new name up at different moments (seen: one
# answering while another still said NXDOMAIN), so wait for two of them.
wait_for_dns() {
  local host="${1#https://}" i r ok
  for i in $(seq 1 30); do
    ok=1
    for r in 1.1.1.1 1.0.0.1; do
      curl -s -m 3 -H 'accept: application/dns-json' \
        "https://$r/dns-query?name=$host&type=A" 2>/dev/null | grep -q '"Answer"' || ok=0
    done
    [[ $ok -eq 1 ]] && return 0
    sleep 1
  done
  return 1
}

cmd_share() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    local found=0 n port st
    while IFS=$'\t' read -r n port st; do
      [[ -n "$n" ]] || continue; found=1
      printf '%-20s %-10s %s\n' "$n" "$st" "$(core share-url "$n")"
    done < <(core shares)
    [[ $found -eq 0 ]] && echo "no sites are shared (covey share <site>)"
    return 0
  fi
  site_exists "$name" || die "no such site: $name (try: covey sites)"
  local row bin pkg
  row="$(core tunnel)" || die "no tunnel configured in share/tunnels.tsv"
  IFS=$'\t' read -r _ bin pkg _ _ <<< "$row"
  [[ -x "$bin" ]] || die "$bin is not installed (sudo pacman -S $pkg)"

  local unit="covey-share@$name.service" port url
  site_lock
  # Checked under the lock: `covey down` and `covey site down` take it too.
  systemctl --user is-active --quiet covey.target || die "covey is down (covey up first)"
  site_disabled "$name" && die "$name is off (covey site up $name first)"
  if systemctl --user is-active --quiet "$unit"; then
    url="$(core share-url "$name")"
    echo "covey: $name is already shared${url:+ - $url}"; return 0
  fi
  # A tunnel that ended on its own (crashed, `covey down`) leaves its listener
  # in the Caddyfile until the next sync; drop it first, or the port check
  # below would mistake covey's own stale listener for someone else's.
  cmd_sync >/dev/null
  port="$(core share-port "$name")"
  # Ports come from the site name, so two sites can collide; and something
  # else may simply be listening there. Refuse rather than share the wrong thing.
  local other op ost
  while IFS=$'\t' read -r other op ost; do
    [[ "$other" != "$name" && "$op" == "$port" && "$ost" != "failed" ]] && \
      die "$name and $other would share loopback port $port (covey unshare $other first)"
  done < <(core shares)
  if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
    die "something else is listening on 127.0.0.1:$port, which $name's share needs"
  fi

  systemctl --user reset-failed "$unit" 2>/dev/null || true
  systemctl --user start "$unit"
  cmd_sync >/dev/null
  # Waiting for the URL and DNS takes seconds; do not hold up other commands.
  site_unlock
  if url="$(share_url_wait "$name")"; then
    wait_for_dns "$url" || warn "$url is not in public DNS yet; give it a few seconds"
    # A poll while the tunnel came up cached the share without its URL.
    drop_doctor_cache
    omarchy-shell covey refresh >/dev/null 2>&1 || true
    echo "covey: $name is shared at $url"
    warn "$SHARE_WARNING"
    echo "end it with: covey unshare $name"
  else
    die "the tunnel did not report a URL (journalctl --user -u $unit)"
  fi
}

cmd_unshare() {
  local name="${1:-}" n
  [[ -n "$name" ]] || die "usage: covey unshare <site>|--all"
  site_lock
  if [[ "$name" == "--all" ]]; then
    while IFS=$'\t' read -r n _ _; do
      [[ -n "$n" ]] || continue
      systemctl --user stop "covey-share@$n.service" 2>/dev/null || true
      systemctl --user reset-failed "covey-share@$n.service" 2>/dev/null || true
    done < <(core shares)
    cmd_sync >/dev/null
    echo "covey: no sites are shared"; return 0
  fi
  local unit="covey-share@$name.service"
  if ! core shares | cut -f1 | grep -qxF -- "$name"; then
    echo "covey: $name is not shared"; return 0
  fi
  systemctl --user stop "$unit" 2>/dev/null || true
  systemctl --user reset-failed "$unit" 2>/dev/null || true
  cmd_sync >/dev/null
  echo "covey: $name is no longer shared"
}

# Run by covey-share@<site>.service; not for direct use.
cmd_share_exec() {
  local name="${1:?}" row bin args port
  row="$(core tunnel)" || die "no tunnel configured in share/tunnels.tsv"
  IFS=$'\t' read -r _ bin _ args _ <<< "$row"
  port="$(core share-port "$name")"
  args="${args//@PORT2@/$((port + 1000))}"
  args="${args//@PORT@/$port}"
  # shellcheck disable=SC2086 # args is a word list from tunnels.tsv
  exec "$bin" $args
}

cmd_logs() {
  case "${1:-caddy}" in
    caddy) journalctl --user -u covey-caddy.service -n "${2:-50}" --no-pager ;;
    php)   journalctl --user -u "covey-fpm@*.service" -n "${2:-50}" --no-pager ;;
    *) die "unknown log target: $1 (caddy|php)" ;;
  esac
}

usage() {
  cat <<EOF
covey - local PHP development environment

  covey install              render config, link systemd units and agent skill
  covey up|down|restart      bring the whole stack up or down (start|stop alias)
  covey autostart [on|off]   whether the stack starts at login
  covey sync                 regenerate site config from $COVEY_SITES, reload
  covey reload               reload the web server config
  covey status               stack state, unit state and memory in use
  covey doctor [--json]      check the platform and every site
  covey trust                trust the local CA in the system and browser stores
  covey sites                list sites, their PHP version and URLs
  covey site [up|down] <n>   take one site in or out of service
  covey site solo <n>        serve only this site; covey site restore undoes it
  covey share [<n>]          put a site on a public URL (cloudflared); list shares
  covey unshare <n>|--all    end a share
  covey php [list|install T|configure T]  PHP providers and extensions
  covey php settings|set K V|unset K      php.ini values for served sites
  covey services [up|down|status|logs]
  covey db [list|create <n>|drop <n>|shell]
  covey logs [caddy|php]     tail logs

Sites: a directory in $COVEY_SITES is served at https://<name>.localhost
PHP:   .covey (php = 8.3) overrides composer.json require.php overrides default
EOF
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  up|start)   shift; cmd_up "$@" ;;
  down|stop)  shift; cmd_down "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  autostart) shift; cmd_autostart "$@" ;;
  reload)  shift; cmd_reload "$@" ;;
  sync)    shift; cmd_sync "$@" ;;
  php)     shift; cmd_php "$@" ;;
  status)  shift; cmd_status "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  trust)   shift; cmd_trust "$@" ;;
  sites)   shift; cmd_sites "$@" ;;
  site)    shift; cmd_site "$@" ;;
  share)   shift; cmd_share "$@" ;;
  unshare) shift; cmd_unshare "$@" ;;
  share-exec) shift; cmd_share_exec "$@" ;;
  services) shift; cmd_services "$@" ;;
  db)      shift; cmd_db "$@" ;;
  logs)    shift; cmd_logs "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try: covey help)" ;;
esac
